---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = "Kiran PK — Software Engineer. Backend-focused engineer building and owning production systems across fintech and SaaS.",
  ogType = "website",
  ogImage = "/profileImg.jpg",
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site);

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Kiran P K",
  url: "https://kiranpk.dev/",
  jobTitle: "Software Engineer",
  email: "mailto:kiranmurali93@gmail.com",
  sameAs: [
    "https://x.com/kiran__pk",
    "https://www.linkedin.com/in/kiran-p-k/",
    "https://github.com/kiranmurali93",
  ],
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Kiran PK",
  url: "https://kiranpk.dev/",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2b3038" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:site_name" content="Kiran PK" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@kiran__pk" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="alternate" type="application/rss+xml" title="Kiran PK — Writing" href="/rss.xml" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <slot name="head" />

    <ClientRouter />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'light' || stored === 'dark'
          ? stored
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <div class="fixed inset-x-0 top-24 z-[100] flex justify-center pointer-events-none px-4">
      <div
        id="copy-toast"
        role="status"
        aria-live="polite"
        class="kpk-toast px-5 py-3 rounded-full text-sm font-medium text-center opacity-0 transition-all duration-300 whitespace-nowrap"
        style="background: var(--heading-strong); color: var(--bg); transform: translateY(-8px);"
      ></div>
    </div>

    <style>
      @media (max-width: 640px) {
        .kpk-toast {
          white-space: normal;
          max-width: 100%;
        }
      }
    </style>

    <script is:inline data-astro-rerun>
      (function () {
        let toastTimeout;

        function showToast(message) {
          const toast = document.getElementById('copy-toast');
          if (!toast) return;
          toast.textContent = message;
          toast.style.opacity = '1';
          toast.style.transform = 'translateY(0)';
          clearTimeout(toastTimeout);
          toastTimeout = setTimeout(function () {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(-8px)';
          }, 2500);
        }

        function copyText(text) {
          if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(text);
          }
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          try {
            document.execCommand('copy');
          } finally {
            document.body.removeChild(textarea);
          }
          return Promise.resolve();
        }

        document.addEventListener('click', function (event) {
          const trigger = event.target.closest('[data-copy-email]');
          if (!trigger) return;
          event.preventDefault();
          const email = trigger.getAttribute('data-copy-email');

          const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
          const mobilePanel = document.getElementById('mobile-panel');
          if (mobileMenuToggle && mobilePanel) {
            mobileMenuToggle.setAttribute('aria-expanded', 'false');
            mobilePanel.classList.add('hidden');
          }

          copyText(email).then(function () {
            showToast('Email copied — reach out at ' + email);
          });
        });
      })();
    </script>
  </body>
</html>
