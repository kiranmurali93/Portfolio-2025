---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: { post, nextPost: sorted[(i + 1) % sorted.length] },
  }));
}

const { post, nextPost } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const canonicalPostURL = new URL(`/blog/${post.id}`, Astro.site).toString();
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  keywords: post.data.tags.join(", "),
  url: canonicalPostURL,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalPostURL },
  author: { "@type": "Person", name: "Kiran P K", url: "https://kiranpk.dev/" },
  publisher: { "@type": "Person", name: "Kiran P K", url: "https://kiranpk.dev/" },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Writing", item: new URL("/blog", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: post.data.title, item: canonicalPostURL },
  ],
};
---

<Layout
  title={`${post.data.title} | Kiran PK`}
  description={post.data.summary}
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.pubDate}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>
  <article class="kpk-section max-w-[720px] mx-auto px-8" style="padding: 56px 32px 96px;">
    <a href="/blog" class="inline-block mb-8 text-[14.5px]" style="color: var(--muted);">← All writing</a>

    <div class="flex items-center gap-2.5 mb-3.5 text-[13.5px]" style="color: var(--muted-dim);">
      <span>{dateFormatter.format(post.data.pubDate)}</span>
      <span>·</span>
      <span>{post.data.readTime}</span>
    </div>
    <h1 class="font-bold mb-4.5 leading-tight" style="font-size: 40px; line-height: 1.15; letter-spacing: -0.01em; color: var(--heading); text-wrap: pretty;">{post.data.title}</h1>
    <div class="flex gap-2 flex-wrap pb-8 border-b" style="border-color: var(--border);">
      {post.data.tags.map((t) => (
        <span class="text-xs px-2.5 py-1 rounded border" style="border-color: var(--border-strong); color: var(--muted);">{t}</span>
      ))}
    </div>

    <div class="kpk-prose" style="padding-top: 32px;">
      <Content />
    </div>

    <div class="flex justify-between items-center gap-4 flex-wrap text-[14.5px] pt-6 border-t" style="margin-top: 56px; border-color: var(--border);">
      <a href="/blog" style="color: var(--muted);">← All writing</a>
      {nextPost && nextPost.id !== post.id && (
        <a href={`/blog/${nextPost.id}`} style="color: var(--accent); text-align: right;">Next: {nextPost.data.title} →</a>
      )}
    </div>
  </article>
</Layout>

<style>
  .kpk-prose {
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-size: 17.5px;
    line-height: 1.75;
    color: var(--text-secondary);
  }
  .kpk-prose :global(h2) {
    margin: 22px 0 0;
    font-weight: 700;
    font-size: 25px;
    line-height: 1.3;
    color: var(--heading-strong);
  }
  .kpk-prose :global(p) {
    margin: 0;
    text-wrap: pretty;
  }
  .kpk-prose :global(ul),
  .kpk-prose :global(ol) {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .kpk-prose :global(blockquote) {
    margin: 0;
    border-left: 2px solid var(--accent);
    padding: 2px 0 2px 20px;
    color: var(--text-secondary);
    font-size: 17px;
  }
  .kpk-prose :global(blockquote p) {
    margin: 0;
  }
  .kpk-prose :global(code) {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.88em;
    padding: 2px 5px;
    border-radius: 4px;
    background: var(--code-bg);
    border: 1px solid var(--border);
    color: var(--heading-strong);
  }
  .kpk-prose :global(pre) {
    margin: 0;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    padding: 16px 18px;
    overflow-x: auto;
  }
  .kpk-prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--text);
  }
  .kpk-prose :global(a) {
    font-size: 15.5px;
  }
  .kpk-prose :global(hr) {
    margin: 0;
    border: none;
    border-top: 1px solid var(--border);
  }
  .kpk-prose :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .kpk-prose :global(th),
  .kpk-prose :global(td) {
    text-align: left;
    padding: 10px 14px;
    border: 1px solid var(--border);
  }
  .kpk-prose :global(th) {
    color: var(--heading-strong);
    font-weight: 600;
    background: var(--code-bg);
  }
  :root,
  :root[data-theme="light"] {
    --code-bg: oklch(0.94 0.006 80);
  }
  :root[data-theme="dark"] {
    --code-bg: oklch(0.22 0.008 250);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --code-bg: oklch(0.22 0.008 250);
    }
  }

  @media (max-width: 640px) {
    .kpk-section { padding: 48px 20px 80px !important; }
  }
</style>

<script is:inline data-astro-rerun>
  (function () {
    document.querySelectorAll('.kpk-prose pre').forEach((pre) => {
      if (pre.dataset.wrapped) return;
      pre.dataset.wrapped = 'true';
      const code = pre.querySelector('code');
      const langMatch = code && code.className.match(/language-(\w+)/);
      const lang = langMatch ? langMatch[1] : 'text';

      const wrapper = document.createElement('div');
      wrapper.className = 'kpk-code-block';
      wrapper.style.cssText = 'background:var(--code-bg); border:1px solid var(--border); border-radius:8px; overflow:hidden;';

      const header = document.createElement('div');
      header.style.cssText = 'display:flex; justify-content:space-between; align-items:center; padding:8px 14px; border-bottom:1px solid var(--border); font-size:11.5px; letter-spacing:0.08em; text-transform:uppercase; color:var(--muted-dim);';

      const langLabel = document.createElement('span');
      langLabel.textContent = lang;

      const copyBtn = document.createElement('span');
      copyBtn.textContent = 'Copy';
      copyBtn.setAttribute('role', 'button');
      copyBtn.style.cssText = 'cursor:pointer; letter-spacing:0.08em;';
      copyBtn.addEventListener('click', () => {
        const text = code ? code.textContent || '' : '';
        if (navigator.clipboard) navigator.clipboard.writeText(text);
        copyBtn.textContent = 'Copied';
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
      });

      header.appendChild(langLabel);
      header.appendChild(copyBtn);

      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      pre.style.border = 'none';
      pre.style.borderRadius = '0';
      wrapper.appendChild(pre);
    });
  })();
</script>
