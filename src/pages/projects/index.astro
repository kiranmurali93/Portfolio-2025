---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => {
  const yearDiff = (b.data.year ?? 0) - (a.data.year ?? 0);
  if (yearDiff !== 0) return yearDiff;
  return (a.data.order ?? 0) - (b.data.order ?? 0);
});
---

<Layout title="Projects | Kiran PK">
  <section class="kpk-section max-w-[760px] mx-auto px-8" style="padding-top: 64px; padding-bottom: 72px;">
    <h1 class="kpk-h1 font-bold mb-12" style="font-size: 38px; color: var(--heading);">Projects</h1>

    <div class="flex flex-col" style="gap: 26px;">
      {sortedProjects.map((project) => (
        <div class="border-b pb-9" style="border-color: var(--border);">
          <div class="kpk-proj-head flex justify-between items-baseline gap-4 mb-2">
            <h3 class="text-[22px] font-semibold m-0" style="color: var(--heading-strong);">{project.data.title}</h3>
            <span class="text-sm flex-shrink-0" style="color: var(--muted-dim);">{project.data.year}</span>
          </div>
          <p class="text-base mb-3.5 max-w-[600px]" style="color: var(--text-secondary);">{project.data.description}</p>

          <div class="flex gap-2 flex-wrap mb-3.5">
            {project.data.tech.map((t) => (
              <span class="text-xs px-2.5 py-1 rounded border" style="border-color: var(--border-strong); color: var(--muted);">{t}</span>
            ))}
          </div>

          <div class="flex gap-5 items-center mb-4">
            {project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener" class="text-sm">Live →</a>}
            {project.data.github && <a href={project.data.github} target="_blank" rel="noopener" class="text-sm">GitHub →</a>}
          </div>

          {(project.data.overview || project.data.features.length > 0 || project.data.architecture) && (
            <details class="kpk-details">
              <summary class="text-sm cursor-pointer select-none list-none" style="color: var(--muted);">
                <span class="kpk-details-label-closed">Details</span>
                <span class="kpk-details-label-open">Hide details</span>
              </summary>
              <div class="flex flex-col gap-4 pt-4 mt-2 border-t text-[15px]" style="border-color: var(--border); color: var(--text-secondary);">
                {project.data.overview && (
                  <div class="border-l-2 pl-4" style="border-color: var(--accent);">
                    <p class="text-xs tracking-wide uppercase mb-1.5" style="color: var(--accent);">Why I built this</p>
                    <p class="m-0 leading-relaxed">{project.data.overview}</p>
                  </div>
                )}
                {project.data.inspiration && (
                  <div class="border-l-2 pl-4" style="border-color: var(--border-strong);">
                    <p class="text-xs tracking-wide uppercase mb-1.5" style="color: var(--muted);">Inspiration</p>
                    <p class="m-0 leading-relaxed">{project.data.inspiration}</p>
                  </div>
                )}
                {project.data.features.length > 0 && (
                  <div>
                    <p class="text-[13px] tracking-wide uppercase mb-2" style="color: var(--muted);">Key Features</p>
                    <ul class="m-0 pl-[18px] flex flex-col gap-1.5">
                      {project.data.features.map((f) => <li>{f}</li>)}
                    </ul>
                  </div>
                )}
                {project.data.architecture && (
                  <div>
                    <p class="text-[13px] tracking-wide uppercase mb-2" style="color: var(--muted);">Architecture</p>
                    <p class="m-0">{project.data.architecture}</p>
                  </div>
                )}
              </div>
            </details>
          )}
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .kpk-details summary::-webkit-details-marker { display: none; }
  .kpk-details-label-open { display: none; }
  .kpk-details[open] .kpk-details-label-closed { display: none; }
  .kpk-details[open] .kpk-details-label-open { display: inline; }

  @media (max-width: 640px) {
    .kpk-proj-head { flex-direction: column !important; align-items: flex-start !important; gap: 4px !important; }
    .kpk-section { padding: 64px 20px 80px !important; }
    .kpk-h1 { font-size: 34px !important; }
  }
</style>
